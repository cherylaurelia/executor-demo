From 8b06095b25e3d44337c47c49944d784950748579 Mon Sep 17 00:00:00 2001
From: Cheryl Aurelia <135518448+cherylaurelia@users.noreply.github.com>
Date: Sat, 7 Nov 2026 06:57:33 -0500
Subject: [PATCH] Describe nested jsonSchema() fields where they sit

A jsonSchema() field inside object(), array() or .optional() was listed
as {} because Effect renders a declaration as {} and only the top-level
schema read the imported document. search and describe showed agents
`unknown` while the call still validated against the document, so an
agent's first guess was rejected.

The lazy decoder now links to Schema.Json with a pass-through filter
that returns the document, the way Schema.Date is described as a
string. A document with references or identifiers resolves against its
own root, so nested it is still listed as {}.

Co-authored-by: Claude <noreply@anthropic.com>
---
 .changeset/nested-json-schema-descriptions.md |  7 +++
 .../imported-json-schema-documents.spec.ts    | 49 ++++++++++++++++++-
 packages/apps/src/implementation/schema.ts    | 24 +++++++++
 3 files changed, 79 insertions(+), 1 deletion(-)
 create mode 100644 .changeset/nested-json-schema-descriptions.md

diff --git a/.changeset/nested-json-schema-descriptions.md b/.changeset/nested-json-schema-descriptions.md
new file mode 100644
index 000000000..14b520148
--- /dev/null
+++ b/.changeset/nested-json-schema-descriptions.md
@@ -0,0 +1,7 @@
+---
+"apps": patch
+---
+
+A `jsonSchema()` field nested in `object()`, `array()` or `.optional()` is listed with its
+document instead of `{}`, so `search` and `describe` show agents the type that its call validates
+against. A nested document with `$ref`, `$defs` or an identifier is still listed as `{}`.
diff --git a/e2e/tests/imported-json-schema-documents.spec.ts b/e2e/tests/imported-json-schema-documents.spec.ts
index efee6b433..0078f2268 100644
--- a/e2e/tests/imported-json-schema-documents.spec.ts
+++ b/e2e/tests/imported-json-schema-documents.spec.ts
@@ -14,17 +14,30 @@ import { appsManifest } from "../support/apps-release.ts";
  * shared parts cannot finish within the scenario deadline. `nested` is 20,000 levels deep: a
  * recursive check overflows the stack and the evaluation fails. Neither schema is parsed, so
  * only construction is exercised; `source.route` shows a shared definition still validates.
+ * `paint` nests imported schemas inside framework schemas: its listed input describes each one
+ * where it sits, except a document with references, which reads differently away from its root.
  */
+const color = { type: "string", enum: ["red", "blue"] };
 const source = `
-import { defineApp, dynamicRouter, jsonSchema, query, router } from "apps";
+import { array, defineApp, dynamicRouter, jsonSchema, object, query, router } from "apps";
 const address = { type: "object", properties: { city: { type: "string" } }, required: ["city"], additionalProperties: false };
 const route = { type: "object", properties: { home: address, work: address }, required: ["home", "work"], additionalProperties: false };
 let shared = { type: "string" };
 for (let level = 0; level < 30; level++) shared = { anyOf: [shared, shared] };
 let nested = { type: "string" };
 for (let level = 0; level < 20000; level++) nested = { not: nested };
+const color = ${JSON.stringify(color)};
+const linked = { $defs: { color }, type: "object", properties: { color: { $ref: "#/$defs/color" } } };
 export default defineApp({}, {
   tools: router({
+    paint: query({
+      input: object({
+        color: jsonSchema(color),
+        palette: array(jsonSchema(color)),
+        accent: jsonSchema(color).optional(),
+        linked: jsonSchema(linked).optional(),
+      }),
+    }, async (_, input) => JSON.stringify(input)),
     source: dynamicRouter({
       list: async () => [{ name: "route", description: "Echo a route", inputSchema: route, readOnly: true }],
       resolve: async (name) => {
@@ -68,6 +81,40 @@ layer(HostedLive, { excludeTestServices: true })("Imported JSON Schemas", (it) =
         }
         const invalid = yield* call({ home: { city: "Springfield" }, work: {} });
         expect(invalid.status, JSON.stringify(invalid.body)).not.toBe(200);
+        const catalog = yield* body(
+          Schema.Struct({
+            items: Schema.Array(
+              Schema.Struct({
+                name: Schema.String,
+                inputSchema: Schema.Struct({
+                  properties: Schema.Unknown,
+                  required: Schema.Array(Schema.String),
+                }),
+              }),
+            ),
+          }),
+          yield* api.request(actors.owner, "GET", `${path}/tools`),
+        );
+        const listed = catalog.items.find((tool) => tool.name === "paint")?.inputSchema;
+        expect(listed?.properties).toEqual({
+          color,
+          palette: { type: "array", items: color },
+          accent: { anyOf: [color, { type: "null" }] },
+          linked: { anyOf: [{}, { type: "null" }] },
+        });
+        expect(listed?.required).toEqual(["color", "palette"]);
+        const paint = (input: unknown) =>
+          api.request(actors.owner, "POST", `${path}/tools/call`, { tool: "paint", input });
+        expect((yield* paint({ color: "red", palette: ["blue"] })).status).toBe(200);
+        for (const input of [
+          { color: "green", palette: [] },
+          { color: "red", palette: ["green"] },
+          { color: "red", palette: [], accent: "green" },
+          { color: "red", palette: [], linked: { color: "green" } },
+        ]) {
+          const rejected = yield* paint(input);
+          expect(rejected.status, JSON.stringify(rejected.body)).not.toBe(200);
+        }
       }),
     ),
   );
diff --git a/packages/apps/src/implementation/schema.ts b/packages/apps/src/implementation/schema.ts
index 97f3956dd..2e62e71e1 100644
--- a/packages/apps/src/implementation/schema.ts
+++ b/packages/apps/src/implementation/schema.ts
@@ -7,6 +7,7 @@ import {
   SchemaGetter,
   SchemaIssue,
   SchemaParser,
+  SchemaTransformation,
 } from "effect";
 import {
   deepCompareStrict,
@@ -414,6 +415,12 @@ const rootDefinitions = (schema: JsonObject): JsonObject | undefined => {
   return definitions;
 };
 
+/** A schema with no references or identifiers, which reads the same under any root. */
+const isStandalone = (schema: JsonObject) => {
+  const definitions = rootDefinitions(schema);
+  return definitions !== undefined && Object.keys(definitions).length === 0;
+};
+
 /**
  * Self-contained schemas placed side by side in one document, such as the branches of a union.
  * A schema whose references all name its root `$defs` gives those entries to the document's root
@@ -1446,6 +1453,23 @@ const lazyCompiledDecoder = (document: () => JsonObject) => {
         Effect.mapError(() => new SchemaIssue.InvalidValue({ message: "Unsupported JSON Schema" })),
         Effect.flatMap((schema) => SchemaParser.decodeUnknownEffect(schema)(input, options)),
       ),
+    {
+      // Describe the document where the schema is nested too, as `Schema.Date` describes its
+      // string. A document with references or identifiers reads differently away from its
+      // root, so it stays undescribed there.
+      toCodecJson: () =>
+        EffectSchema.link<EffectSchema.Json>()(
+          EffectSchema.Json.check(
+            EffectSchema.makeFilter(() => true, {
+              toJsonSchema: () => {
+                const document = read();
+                return isStandalone(document) ? document : [{}, true];
+              },
+            }),
+          ),
+          SchemaTransformation.passthrough(),
+        ),
+    },
   );
   return { decoder: withLazyJsonSchemaDocument(decoder, read), compile };
 };
